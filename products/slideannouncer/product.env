# Device-side settings for this product, installed at
# /opt/slide-announcer/product.env and sourced by the kiosk start script.
# Shell syntax (KEY=value), no spaces around the =.

# What Chromium opens in kiosk mode. The local app's own page for
# products whose main screen is served from this device; a remote https
# URL for products that are a web portal (see docs/PRODUCTS.md).
KIOSK_URL=http://localhost/kiosk
