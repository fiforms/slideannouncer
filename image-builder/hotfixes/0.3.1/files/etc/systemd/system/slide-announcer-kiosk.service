[Unit]
Description=Slide Announcer kiosk display (labwc + Chromium)
After=slide-announcer-firstboot.service slide-announcer-local-app-seed.service slide-announcer-backend.service seatd.service
Requires=slide-announcer-firstboot.service slide-announcer-local-app-seed.service seatd.service
Wants=slide-announcer-backend.service

[Service]
Type=simple
User=slideannouncer
Group=slideannouncer
SupplementaryGroups=video render input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/local/bin/slide-announcer-kiosk-start.sh
Restart=always
RestartSec=2
# Routinely stopped now (not just at reboot/shutdown) by
# slide-announcer-power-button.service's sleep toggle — cap how long that
# stop can wait on Chromium/labwc instead of systemd's 90s default.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
