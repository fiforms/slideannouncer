[Unit]
Description=Slide Announcer on-demand SRT video-sink listener
After=slide-announcer-power-button-dirs.service slide-announcer-kiosk.service seatd.service
Requires=slide-announcer-power-button-dirs.service seatd.service

[Service]
Type=simple
User=slideannouncer
Group=slideannouncer
# video/render for mpv's V4L2 M2M hwdec + EGL/GPU access (same reasoning
# as slide-announcer-kiosk.service's SupplementaryGroups) — playback now
# runs as a Wayland client inside the kiosk's own already-running labwc
# compositor rather than taking DRM/KMS directly, and audio goes out via
# --ao=pipewire through that same running PipeWire graph rather than bare
# ALSA, so `audio` is no longer needed here (see srt-sink-monitor.py's
# module docstring and kiosk-start.sh).
SupplementaryGroups=video render
ExecStart=/usr/local/sbin/slide-announcer-srt-sink-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
