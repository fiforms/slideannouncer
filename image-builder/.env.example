# Copy this file to .env and fill in the values below. build.sh sources
# .env if present and refuses to build (cleanly, before the expensive
# pi-gen stage) if any required value is unset or missing.

# The AnnouncementSlides server this fleet pairs/syncs/checks OTA updates
# against — one self-hosted server per fleet, baked into every image built
# with this .env. No trailing slash.
SLIDE_ANNOUNCER_SERVER_URL=
#
# No pair yet? Run ./generate-rauc-cert.sh dev (throwaway self-signed pair,
# never for a real fleet) or ./generate-rauc-cert.sh production (offline
# CA + rotatable signing cert — see that script's MANIFEST.txt output for
# what needs backing up and how).
RAUC_CERT_PATH=
RAUC_KEY_PATH=

# What gets baked into every device's /etc/rauc/keyring.pem at build time.
# Optional — defaults to RAUC_CERT_PATH, which is correct for the "dev"
# mode above (one cert does both jobs). For "production" mode, set this to
# the CA cert instead (ca-cert.pem) — devices then trust the CA, not the
# day-to-day signing cert directly, so the signing cert/key can be rotated
# later without ever re-flashing a device in the field.
RAUC_KEYRING_CERT_PATH=

# WiFi regulatory domain (ISO 3166-1 alpha-2, e.g. US, CA, GB). Optional —
# defaults to US. The Pi's WiFi radio is soft rfkill-blocked by the kernel
# until this is set (regardless of NetworkManager config), so leaving it
# wrong for where devices actually deploy means WiFi scan/connect won't see
# any networks until someone runs `sudo raspi-config nonint do_wifi_country
# <CC>` at the console by hand.
SLIDE_ANNOUNCER_WIFI_COUNTRY=

# Extra /boot/firmware/config.txt lines this fleet's hardware needs (fan
# control overlay, a display override, etc.) that a stock image doesn't
# set. Optional, free-form, one or more raw config.txt lines — appended
# under their own unconditional [all] section, so don't include a
# [section] header yourself. Survives RAUC OTA/tryboot switching: every
# future OTA bundle is built from this same .env, so it's baked into
# whichever slot ends up active, not just the initial image.
#
# Example (a GPIO-controlled fan, temp threshold in millidegrees C):
# SLIDE_ANNOUNCER_BOOT_CONFIG_EXTRA=dtoverlay=gpio-fan,gpiopin=14,temp=65000
#
# Multiple lines: use a quoted, actual multi-line value (this file is
# sourced as a shell script, not parsed as strict key=value):
# SLIDE_ANNOUNCER_BOOT_CONFIG_EXTRA="dtoverlay=gpio-fan,gpiopin=14,temp=65000
# dtparam=some-other-thing=1"
SLIDE_ANNOUNCER_BOOT_CONFIG_EXTRA=

# Console/keyboard login password for the 'slideadmin' account. Optional —
# leave blank and build.sh generates a random one per build (printed to the
# build log). Set this if you want a fixed, memorable password across
# builds instead (e.g. for a fleet of devices field techs log into).
SLIDEADMIN_PASSWORD=

# Root account password. Optional — leave blank and root stays locked (the
# secure default; a real fleet image should never set this). Debugging and
# development only: gives you a password sulogin/emergency mode will
# accept, so a device that drops into emergency mode is recoverable at the
# console without pulling the storage and editing /etc/shadow by hand.
ROOT_DEV_PASSWORD=
