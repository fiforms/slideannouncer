[Unit]
Description=Slide Announcer Revelation peering (mDNS + Socket.IO follower client)
After=slide-announcer-firstboot.service slide-announcer-kiosk.service
Requires=slide-announcer-firstboot.service
# Only needs the kiosk's CDP port up to actually redirect it — doesn't need
# to be stopped/restarted alongside it the way slide-announcer-srt-sink's
# `takeover` does, since it only ever navigates an already-running tab.
Wants=slide-announcer-kiosk.service

[Service]
Type=simple
User=slideannouncer
Group=slideannouncer
ExecStart=/opt/slide-announcer/venv/bin/python3 /usr/local/sbin/slide-announcer-revelation-peer
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
