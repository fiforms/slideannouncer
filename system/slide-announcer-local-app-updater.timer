[Unit]
Description=Periodic trigger for slide-announcer-local-app-updater.service

[Timer]
# Version *checks* are cheap (just reading heartbeat.py's already-cached
# status file) — 15 min keeps the idle-window apply gate (see
# local_app_updater.py) responsive without polling anything remote itself.
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
