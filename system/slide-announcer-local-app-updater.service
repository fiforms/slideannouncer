[Unit]
Description=Slide Announcer local-app self-update check/apply (Tier 2)
# /data must already hold a seeded install and the backend must have run at
# least once to have a heartbeat.json to read update info from.
After=slide-announcer-local-app-seed.service slide-announcer-backend.service
Requires=slide-announcer-local-app-seed.service

[Service]
Type=oneshot
User=slideannouncer
Group=slideannouncer
ExecStart=/opt/slide-announcer/venv/bin/python3 /opt/slide-announcer/updater/local_app_updater.py
