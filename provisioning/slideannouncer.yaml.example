# Slide Announcer persistent config — see docs/BUILDING.md's
#
#
# WiFi/network settings do NOT go in this file — edit network-config
# (also on this boot partition) instead. 

# Default UI language hint for initial setup only — "en" or "es". Used
# once, to pick a sensible starting language for the first setup screen
# before anyone has configured the device. Not a permanent setting: it
# can be changed at any time afterward from the device's own Settings
# menu, and doing so has no effect on this file.

default_language: en


# The AnnouncementSlides server this device talks to (pairing/sync/
# heartbeat, and OS OTA update checks) — e.g. https://your-server.example.org,
# no trailing slash. Read fresh by the local-app backend and
# slide-announcer-update alike on every request, so changing it (and
# rebooting, or restarting slide-announcer-backend) is all that's needed
# to move a device to a different server — no rebuild/reflash required.
# This is what lets one image serve multiple independent servers: build it
# once, then set this per-device (or pre-provision it onto the boot
# partition before first boot, same as network-config below).
# Missing/blank here is a hard failure — pairing, sync, heartbeat, and OTA
# checks all refuse to run rather than silently doing nothing.

# server_url: https://your-server.example.org


# Set to "locked" to disable Ctrl+Alt+F# virtual-console switching on this
# device (system/scripts/vtlock-apply.py, run once per boot before the
# kiosk starts). Comment this line to enable VT switching, use 
# Ctrl+Alt+F3 (VT3) for debugging info.

vt_lockswitch: locked

# Set to "true" to enable sshd on this device.  (Default: disabled)

# ssh_enabled: true


# SSH public key(s) authorized to log in as 'slideadmin' — a literal
# authorized_keys file's contents (one key per line), written to
# /home/slideadmin/.ssh/authorized_keys on every boot. This is read every
# boot. Removing this key entirely deletes the
# authorized_keys file outright, revoking SSH access. Has no effect
# without ssh_enabled: true above. There is no password authentication
# over SSH.

# ssh_authorized_keys: |
#   ssh-ed25519 AAAA...


# Overrides the auto-derived per-device hostname (normally
# slideannouncer-###### — a stable 6-digit number derived from
# device_uuid) — e.g. to give a specific device a friendly, memorable
# name instead. Takes effect on next boot (firstboot.py's set_hostname());
# advertised via mDNS as <hostname>.local (avahi-daemon, already enabled
# in this image with publish-workstation=yes), which is what lets an SRT
# video-sink sender on Windows/macOS address this specific device by name.

# hostname: front-lobby-display


# device_uuid / device_uuid_check: do not modify these. firstboot.py
# generates a fresh, consistent pair on the device's first boot — see
# provisioning/README.md and SLIDE_ANNOUNCER.md's "Device identity &
# anti-clone protection". Hand-editing device_uuid without the matching
# secret (which never leaves /data) just triggers a fresh identity
# regeneration on the next boot rather than doing anything useful.

device_uuid:
device_uuid_check:
