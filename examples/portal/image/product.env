# A kiosk whose main screen is a remote web portal. The setup wizard, Wi-Fi
# and Settings screens still run from this device (http://localhost/...).
#
# NOTE: a remote KIOSK_URL skips the first-run wizard (and so Wi-Fi setup) on a
# fresh device. A product that needs the wizard should leave this unset and use
# Product.confirm_server_url + a setupSteps step instead — docs/SERVER_URL.md.
KIOSK_URL=https://example.org/
